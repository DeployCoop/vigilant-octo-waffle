#!/usr/bin/env bash
if [[ "${1:-}" == "k3s:up" || "${1:-}" == "k3s:build" ]]; then
  shift
  exec ./src/k3s_up.sh "$@"
elif [[ "${1:-}" == "k3s:down" || "${1:-}" == "k3s:kill" || "${1:-}" == "kill" ]]; then
  shift
  exec ./src/k3s_kill.sh "$@"
elif [[ "${1:-}" == "k3s:rebuild" ]]; then
  shift
  exec ./src/k3s_build.sh --rebuild "$@"
elif [[ "${1:-}" == "k3s:add-node" || "${1:-}" == "k3s:join" || "${1:-}" == "add-node" ]]; then
  shift
  exec ./src/k3s_add_node.sh "$@"
elif [[ "${1:-}" == "k3s:tune" || "${1:-}" == "tune" ]]; then
  shift
  exec ./src/k3s_tune.sh "$@"
elif [[ "${1:-}" == "k3s:kmod" || "${1:-}" == "kmod" ]]; then
  shift
  exec ./src/k3s_kmod.sh "$@"
elif [[ "${1:-}" == "k3s:registries" || "${1:-}" == "registries" ]]; then
  shift
  exec ./src/k3s_registries.sh "$@"
elif [[ "${1:-}" == "k3s:ping" || "${1:-}" == "ping" ]]; then
  shift
  exec ./src/k3s_ping.sh "$@"
elif [[ "${1:-}" == "k3s:etcd" || "${1:-}" == "k3s:snapshot" || "${1:-}" == "snapshot" ]]; then
  shift
  exec ./src/k3s_etcd.sh "$@"
elif [[ "${1:-}" == "k3s:drain" || "${1:-}" == "drain" ]]; then
  shift
  exec ./src/k3s_drain.sh drain "$@"
elif [[ "${1:-}" == "k3s:cordon" || "${1:-}" == "cordon" ]]; then
  shift
  exec ./src/k3s_drain.sh cordon "$@"
elif [[ "${1:-}" == "k3s:uncordon" || "${1:-}" == "uncordon" ]]; then
  shift
  exec ./src/k3s_drain.sh uncordon "$@"
elif [[ "${1:-}" == "k3s:certs" || "${1:-}" == "certs" ]]; then
  shift
  exec ./src/k3s_certs.sh check "$@"
elif [[ "${1:-}" == "k3s:rotate-certs" ]]; then
  shift
  exec ./src/k3s_certs.sh rotate "$@"
elif [[ "${1:-}" == "k3s:health" || "${1:-}" == "k3s:status" ]]; then
  shift
  exec ./src/k3s_health.sh "$@"
elif [[ "${1:-}" == "k3s:cis" || "${1:-}" == "cis" ]]; then
  shift
  exec ./src/k3s_cis.sh "$@"
elif [[ "${1:-}" == "k3s:upgrade" || "${1:-}" == "upgrade" ]]; then
  shift
  exec ./src/k3s_upgrade.sh "$@"
fi

: "${BIG_LIST:=./src/big_list}"
source ./src/sourceror.bash
export this_cwd=$(pwd)

main() {
  set -e
  src/secrets.sh
  if [[ $THIS_K8S_TYPE == "kind" ]]; then
    src/kindDown.sh
    sleep 1
    if [[ ${THIS_REG_ENABLE} == "true" ]]; then
      src/localregistry_start.sh
    fi
    src/kindUp.sh
    if [[ ${THIS_REG_ENABLE} == "true" ]]; then
      #src/registry-proxy.sh
      src/localregistry_setupnodes.sh
    fi
  elif [[ $THIS_K8S_TYPE == "k3d" ]]; then
    src/k3dDown.sh
    sleep 1
    src/k3dUp.sh
  elif [[ $THIS_K8S_TYPE == "k3s" ]]; then
    if kubectl get nodes >/dev/null 2>&1; then
      echo "==> K3s cluster is running and reachable via kubectl, proceeding..."
    else
      echo "==> K3s cluster is not running. Initializing and bringing up K3s..."
      ./src/k3s_up.sh --skip-up
      if ! kubectl get nodes >/dev/null 2>&1; then
        echo "Error: K3s cluster failed to start." >&2
        exit 1
      fi
    fi
  else
    echo "THIS_K8S_TYPE is not set, aborting!"
    exit 1
  fi
  set -eu
  set -x
  src/namespacer.sh monitoring
  src/namespacer.sh nfs-server
  initializer "$this_cwd/init/cluster"

  if [[ ${THIS_EARLY_END} == 'true' ]]; then
    exit 0
  fi

  # certmanager
  src/certmanager.sh
  w8_all_namespace cert-manager

  kubectl apply -f .secrets/${THIS_SECRETS}.yaml
  if [[ ${THIS_CLUSTER_INGRESS} == "traefik" ]]; then
    src/traefik.sh
  elif [[ ${THIS_CLUSTER_INGRESS} == "nginx" ]]; then
    src/nginx.sh
    w8_all_namespace ingress-nginx
  elif [[ ${THIS_CLUSTER_INGRESS} == "haproxy" ]]; then
    src/haproxy.sh
  else
    echo 'unrecognized ingress'
    exit 1
  fi
  if [[ $THIS_K8S_TYPE == "kind" ]]; then
    echo 'kind'
  elif [[ $THIS_K8S_TYPE == "k3d" ]]; then
    echo 'k3d'
  else
    echo 'k3s'
  fi
  # CD Runners: ArgoCD and/or FluxCD (https://fluxcd.io)
  if [[ "${THIS_CD_RUNNER:-argocd}" == "argocd" || "${THIS_CD_RUNNER:-argocd}" == "both" ]]; then
    src/argocd.sh
  fi
  if [[ "${THIS_CD_RUNNER:-argocd}" == "flux" || "${THIS_CD_RUNNER:-argocd}" == "fluxcd" || "${THIS_CD_RUNNER:-argocd}" == "both" ]]; then
    src/flux.sh
  fi
  #openEBS
  src/openebs.sh
  src/rook-ceph-operator.sh
  src/csi-driver-nfs.sh
  # kubegres
  src/kubegres.sh
  src/keycloak.sh
  src/dockerCreds.sh
  para_runner "${BIG_LIST}"
}

time main
