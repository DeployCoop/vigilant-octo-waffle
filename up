#!/usr/bin/env bash
set -e

# ==============================================================================
# up - Unified Entrypoint for Vigilant Octo Waffle Orchestrator & Ink TUI
# ==============================================================================
# All legacy shell scripting has been migrated to TypeScript domain libraries
# in packages/orchestrator and the interactive/headless CLI in apps/ink.
# ==============================================================================

# Ensure Node & pnpm are on PATH
export PATH="/root/.nvm/versions/node/v24.21.0/bin:${PATH}"

if [[ $# -eq 0 ]]; then
  if [[ -t 1 && -z "${CI:-}" ]]; then
    exec ./bin/vow
  else
    exec ./bin/vow up
  fi
fi

case "$1" in
  ink|tui|ui|-i|--interactive)
    shift || true
    exec ./bin/vow -i "$@"
    ;;
  vow)
    shift
    exec ./bin/vow "$@"
    ;;
  up)
    shift
    exec ./bin/vow up "$@"
    ;;
  doctor|config:doctor|config:check|config:fix)
    shift
    exec ./bin/vow doctor "$@"
    ;;
  namespaces|namespaces:sync|ns:sync)
    shift
    exec ./bin/vow namespaces "$@"
    ;;
  secrets|secrets:sync|sync:secrets)
    shift
    exec ./bin/vow secrets "$@"
    ;;
  ingress|ingress:*|certmanager)
    shift
    exec ./bin/vow ingress "$@"
    ;;
  storage|storage:*|k3s:storage)
    shift
    exec ./bin/vow storage "$@"
    ;;
  app|apps)
    shift
    exec ./bin/vow app "$@"
    ;;
  k3s|k3s:*)
    sub="${1#k3s:}"
    shift
    if [[ "$sub" == "k3s" ]]; then
      exec ./bin/vow k3s "$@"
    else
      exec ./bin/vow k3s "$sub" "$@"
    fi
    ;;
  waffle|waffle:*)
    sub="${1#waffle:}"
    shift
    if [[ "$sub" == "waffle" ]]; then
      exec ./bin/vow waffle "$@"
    else
      exec ./bin/vow waffle "$sub" "$@"
    fi
    ;;
  *)
    exec ./bin/vow "$@"
    ;;
esac
