{
  "name": "@vow/orchestrator",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "lint": "eslint src --max-warnings 152",
    "test": "node --test --test-concurrency=1 dist/__tests__/*.test.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test:parity:update": "tsc -p tsconfig.json && VOW_PARITY_UPDATE=1 node --test dist/__tests__/parity.test.js"
  },
  "dependencies": {
    "@casl/ability": "^7.0.2",
    "@kubernetes/client-node": "^2.0.0",
    "jose": "^6.2.12",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^6.0.3"
  }
}
