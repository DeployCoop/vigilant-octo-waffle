{
  "name": "vigilant-octo-waffle-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @vow/orchestrator build && pnpm --filter @vow/web dev",
    "build": "pnpm --filter @vow/orchestrator build && pnpm --filter @vow/ink build && pnpm --filter @vow/web build",
    "start": "pnpm --filter @vow/web start",
    "ink": "pnpm --filter @vow/ink build && ./bin/vow",
    "vow": "./bin/vow",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
