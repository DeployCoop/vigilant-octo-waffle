{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VigilantOctoWaffle",
  "version": "1.0.0",
  "identifier": "coop.deploy.vigilantoctowaffle",
  "build": {
    "beforeDevCommand": "pnpm --filter @vow/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @vow/web build",
    "frontendDist": "../apps/web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Vigilant Octo Waffle Control Plane",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
